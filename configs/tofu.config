params {
  //Software DB locations, UNCOMMENT AND CHANGE THEM:

  //metaphlan_db = "${baseDir}/databases/Metaphlan/4.0"
  //kraken2_db = "${baseDir}/databases/Kraken2/k2_viral_20210517"
  //humann_db = "${baseDir}/databases/Humann3/3.6" 
  gtdbtk_reference = "/home/isilon/dienerlab/refs/gtdbtk/release232"

  //For host read removal list your host genomes as bowtie2 index in this named list with full path to the basename of the index:
	'genomes' {
		'human' {
      bowtie_index = "/home/isilon/dienerlab/refs/T2T_13v2/hs1"
		}
	}

  // MAXIMUM PER PROCESS CONFIGS, CHANGE THEM TO YOUR HARDWARE SPECS
  max_memory = 240.GB
  max_cpus = 32
  max_time = 48.h
  
  //Scratch. Does your system support scratch? If not, leave it false
  scratch = false
}

singularity {
    runOptions = "--no-home -B /home/isilon/,/home/gpfs/o_diener,${env('TMPDIR')}"
    cacheDir = "${env("HOME")}/cache"
}

//Default for total execution, remove this whole part if you are using a different option above than executor='local':
executor {
  cpus = 32
  memory = 240.GB
}

profiles {
    medbionode {
        executor {
            name = "slurm"
            queueSize = 128
            pollInterval = '30 sec'
            dumpInterval = '30 sec'
            queueStatInterval = '1 min'
            exitReadTimeout = '10 min'
            killBatchSize = 100
            submitRateLimit = '100/1 min'
        }
        
        process {
            scratch = false
            beforeScript = 'export PATH=$PATH:$HOME/miniforge3/bin:/usr/bin/ OMP_NUM_THREADS=1'

            queue = 'cpu'

            withLabel: gpu {
                queue = params.gpu ? 'gpu' : 'cpu'
                clusterOptions = params.gpu ? '--gpus=1' : null
            }
			
			withLabel: 'exclusive' {
 	        	clusterOptions = null
            }
  
            withLabel: 'vamb' {
                time = "1d"
            } 
            
        }

        tower {
            workspaceId = secrets.INTERNALID
            accessToken = secrets.LABTOKEN
            enabled = true
        }

    }

    local {
        executor {
            name = "local"
            cpus = 10
            memory = "512 GB"
        }
        
        tower {
            workspaceId = secrets.INTERNALID
            accessToken = secrets.LABTOKEN
            enabled = true
        }
        
    }

    collab {
        tower {
            workspaceId = secrets.COLLABID
            accessToken = secrets.LABTOKEN
            enabled = true
        }
    }
}
