profiles {
    standard {
        executor {
            name = "local"
            cpus = 12
            memory = "128 GB"
        }
    }

    slurm {
        executor {
            name = "slurm"
            queueSize = 40
            pollInterval = '2 min'
            dumpInterval = '3 min'
            queueStatInterval = '5 min'
            exitReadTimeout = '10 min'
            killBatchSize = 50
            submitRateLimit = '40 min'
        }
        // process.queue = "cpu"

    }

    tower {
        workspaceId = secrets.COLLABID
        accessToken = secrets.LABTOKEN
        enabled = true
    }
}

singularity.runOptions = "-B $TMPDIR"
